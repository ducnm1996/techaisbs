APP_NAME="TechAI Portal"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://portal.example.com
APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=portal_example
DB_USERNAME=portal_runtime
DB_PASSWORD=
DB_TABLE_PREFIX=portal_
SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=sync
LOG_CHANNEL=single
LOG_LEVEL=warning
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=portal@example.com
MAIL_FROM_NAME="TechAI Portal"
HISTORY_INDEX_KEY=
HISTORY_RETENTION_DAYS=90
BACKUP_RETENTION_DAYS=7
DEVICE_TOKEN_DAYS=30
